{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sql-server-db;Database=EcgVisionDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    /* "Key": "",*/
    "Issuer": "https://ecgvision-api.com",
    "Audience": "https://ecgvision-app.com",
    "ExpirationSeconds": 7200
  },
  "Storage": {
    "Local": {
      "TempRoot": "temp_uploads",
      "LandingZone": "landing-zone",
      "StorageDurationHours": 6,
      "CreateIfNotExists": true
    },
    "S3": {
      /*"ServiceUrl": "",
      "BucketName": "",
      "AccessKey": "",
      "SecretKey": "",
      "Region": "",*/
      "PresignedUrlDurationMinutes": 60
    }
  },
  "Python": {
    "PythonExe": "/usr/bin/python3",
    "ScriptFolder": "/app/Scripts"
  }
}
